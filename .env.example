# Public application settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false

# Clerk authentication (server + browser). Put real keys in .env.local — Next.js does not load this file.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# Firebase Admin / Firestore only. Never expose these as NEXT_PUBLIC_* values.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=launch-brawl
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Freemius hosted checkout
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_PLAN_ID_SPONSORED_REACH=
FREEMIUS_SANDBOX=false

# Email delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=Launch Brawl <hello@example.com>

# Managed rate limiting (required when NODE_ENV=production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# S3-compatible/R2 media storage (required when NODE_ENV=production)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=

# Scheduled jobs and initial admin bootstrap
CRON_SECRET=
ADMIN_USER_IDS=

# Optional observability
SENTRY_DSN=
